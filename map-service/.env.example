# Copy this file to .env and fill in your Supabase Postgres connection string.
#
# IMPORTANT for this deployment: use the "Transaction" pooler connection
# string, not the direct connection. Supabase: Project Settings -> Database
# -> Connection string -> pick "Transaction" mode (port 6543, host looks
# like aws-0-<region>.pooler.supabase.com). The app opens a fresh
# connection per request (see api/database.py for why), and on Vercel many
# serverless instances can run at once -- the pooler is what keeps that
# from exceeding Supabase's direct connection limit. Also make sure the
# postgis extension is enabled under Database -> Extensions.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres

# Origins allowed to call this API from a browser (comma-separated).
# Use * for local development with the bundled single-file frontend.
CORS_ORIGINS=*
