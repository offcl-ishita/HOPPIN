# Copy this file to .env and fill in your Supabase Postgres connection string.
# Supabase: Project Settings -> Database -> Connection string -> URI
# (use the "Session pooler" or direct connection string; make sure the DB
# has the postgis extension enabled under Database -> Extensions).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres

# Origins allowed to call this API from a browser (comma-separated).
# Use * for local development with the bundled single-file frontend.
CORS_ORIGINS=*
